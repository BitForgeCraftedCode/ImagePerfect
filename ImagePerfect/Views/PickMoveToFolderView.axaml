<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
			 xmlns:vm="using:ImagePerfect.ViewModels"
			 x:DataType="vm:PickMoveToFolderViewModel"
			 IsEnabled="{Binding CanMoveFolders}"
             x:Class="ImagePerfect.Views.PickMoveToFolderView">
	<Button Content="Move Folders" 
			Command="{Binding SelectMoveToFolderCommand}" 
			CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" 
			IsEnabled="{Binding !$parent[StackPanel].((vm:FolderViewModel)DataContext).IsRoot}" 
			Classes="main-btn" 
			Width="320" />
</UserControl>
